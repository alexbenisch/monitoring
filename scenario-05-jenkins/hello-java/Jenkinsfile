// hello-java pipeline.
//   v1: check out, build and test, publish the test results.
//   v2: build the image with Kaniko and push it to the in-cluster registry.
//   v3: deploy it to the apps namespace and smoke-test /hello.
//
// The job polls the whole monitoring repo, so most commits it sees are
// observability changes that have nothing to do with this app. A build only
// runs when something under scenario-05-jenkins/hello-java changed, or when
// someone starts it by hand.

// Kaniko runs inside a pod, so it pushes to the registry's in-cluster name.
// The node pulls the same image as localhost:5000/hello-java (see
// scripts/20-registry.sh).
def REGISTRY = 'registry.kube-system.svc.cluster.local'
def PULL_REGISTRY = 'localhost:5000'

// Same minor version as the cluster.
def KUBECTL_VERSION = 'v1.37.0'

pipeline {
  // No agent at the top: a skipped build should not start a pod.
  agent none

  // Jenkins is only on the tailnet, so GitHub cannot deliver a webhook to it.
  // Polling is the honest lab answer; production would use a webhook or an
  // outbound-only agent.
  triggers {
    pollSCM('H/2 * * * *')
  }

  options {
    buildDiscarder(logRotator(numToKeepStr: '20'))
    timeout(time: 30, unit: 'MINUTES')
  }

  stages {
    stage('hello-java') {
      when {
        beforeAgent true
        anyOf {
          changeset 'scenario-05-jenkins/hello-java/**'
          triggeredBy 'UserIdCause'
        }
      }
      // One pod for the whole build. The jnlp container is added by the
      // plugin; the agent default of 512Mi is sized for jnlp alone, so the
      // other containers get their own memory.
      agent {
        kubernetes {
          defaultContainer 'maven'
          yaml '''
            apiVersion: v1
            kind: Pod
            spec:
              # Allowed to apply the hello-java manifests in apps and nothing
              # else (k8s/deployer-rbac.yaml).
              serviceAccountName: hello-java-deployer
              containers:
                - name: maven
                  image: maven:3.9-eclipse-temurin-21
                  command: ["sleep"]
                  args: ["infinity"]
                  resources:
                    requests:
                      cpu: 500m
                      memory: 1Gi
                    limits:
                      memory: 1536Mi
                  volumeMounts:
                    - name: maven-repo
                      mountPath: /root/.m2
                # Kaniko builds the image in userspace. The alternative,
                # mounting the node's container socket, would hand every
                # Jenkinsfile root on the node. The debug tag carries the
                # busybox shell that Jenkins' sh step needs.
                - name: kaniko
                  image: gcr.io/kaniko-project/executor:v1.24.0-debug
                  command: ["sleep"]
                  args: ["infinity"]
                  resources:
                    requests:
                      cpu: 500m
                      memory: 1Gi
                    limits:
                      # The Dockerfile runs a full Maven build of its own.
                      memory: 2Gi
              volumes:
                # Without a shared cache every build downloads Spring Boot's
                # whole dependency tree again.
                - name: maven-repo
                  persistentVolumeClaim:
                    claimName: maven-repo
          '''
        }
      }
      stages {
        stage('Build and test') {
          steps {
            dir('scenario-05-jenkins/hello-java') {
              sh 'mvn -B verify'
            }
          }
          post {
            always {
              junit 'scenario-05-jenkins/hello-java/target/surefire-reports/*.xml'
            }
          }
        }

        stage('Image') {
          steps {
            script {
              // Build number for ordering, commit for tracing back to source.
              // Set here rather than in an environment block so the deploy
              // stages see it too.
              env.TAG = "${env.BUILD_NUMBER}-${env.GIT_COMMIT.take(7)}"
              env.IMAGE = "${REGISTRY}/hello-java:${env.TAG}"
            }
            container('kaniko') {
              // --insecure: the addon registry speaks plain HTTP. Fine in a
              // lab, and must never leave one.
              sh '''
                /kaniko/executor \
                  --context=dir://$WORKSPACE/scenario-05-jenkins/hello-java \
                  --dockerfile=Dockerfile \
                  --destination=$IMAGE \
                  --insecure
              '''
            }
            echo "Pushed ${env.IMAGE}"
          }
        }

        stage('Deploy') {
          steps {
            // An overlay made on the fly: the checked-in manifests stay the
            // by-hand version, and only the image and the BUILD_TAG the app
            // reports are swapped for this build's.
            writeFile file: 'deploy/kustomization.yaml', text: [
              'resources:',
              '  - ../scenario-05-jenkins/hello-java/k8s',
              'images:',
              '  - name: obs-lab/hello-java',
              "    newName: ${PULL_REGISTRY}/hello-java",
              "    newTag: \"${env.TAG}\"",
              'patches:',
              '  - target: {kind: Deployment, name: hello-java}',
              '    patch: |-',
              '      - op: replace',
              '        path: /spec/template/spec/containers/0/env/0/value',
              "        value: \"${env.TAG}\"",
              '',
            ].join('\n')
            sh """
              curl -fsSLo /usr/local/bin/kubectl https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl
              chmod +x /usr/local/bin/kubectl
              kubectl apply -k deploy
              kubectl -n apps rollout status deployment/hello-java --timeout=5m
            """
          }
        }

        stage('Smoke test') {
          steps {
            // Through the Service, the way a client would arrive. The build
            // tag in the answer proves the new pods are serving, not the old
            // ones that were there before the rollout.
            sh '''
              body=$(curl -fsS --retry 5 --retry-delay 3 --retry-all-errors \
                http://hello-java.apps.svc.cluster.local:8080/hello)
              echo "$body"
              echo "$body" | grep -q "\\"build\\":\\"$TAG\\""
            '''
          }
        }
      }
    }
  }
}
