<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>uk.kubetest</groupId>
  <artifactId>hello-java</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>hello-java</name>
  <description>Deliberately boring service. The pipeline is the lesson.</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Gives /actuator/health, which the Kubernetes probes use. Its
         liveness and readiness groups are separate endpoints on purpose:
         a pod that is alive but not ready should be restarted by neither. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- The payoff for having built scenarios 01 and 02 first. This one
         dependency turns /actuator/prometheus into a scrape target, so the
         app this pipeline deploys is visible in the existing Grafana without
         writing a line of instrumentation. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Spring Boot 4 split the test slices out of spring-boot-test-autoconfigure
         into per-technology modules, so @WebMvcTest is no longer on the
         classpath via spring-boot-starter-test alone. Under Boot 3 this
         dependency did not exist and the annotation lived in
         org.springframework.boot.test.autoconfigure.web.servlet. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
